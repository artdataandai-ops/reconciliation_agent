# Used by `vite build` (production). The frontend (Cloudflare Pages) calls the backend
# cross-origin behind the edge nginx. api.js appends /api, so requests go to
# https://ai.arttechgroup.com:7777/reconciliation-agent/api/*.
# Must match the edge nginx location prefix. Change here + rebuild + redeploy if it moves.
VITE_API_BASE_URL=https://ai.arttechgroup.com:7777/reconciliation-agent
