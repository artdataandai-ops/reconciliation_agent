# Copy to .env and fill in after creating the agent in Lyzr Studio.
# If LYZR_API_KEY / LYZR_AGENT_ID are blank, the backend uses a deterministic stub
# (the demo still works end-to-end).

LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_API_URL=https://agent.api.lyzr.app/v2/chat/
LYZR_USER_ID=recon-poc@thredd.demo

# Where the generated sample files live (output of gen_unrecon_day.py)
DATA_DIR=c:\tasks\vss110\data

# Dataset auto-regeneration on backend startup (fresh dates every run; numbers unchanged).
# AUTO_REGEN=1 (default) regenerates for "today"; set 0 to serve existing files untouched.
AUTO_REGEN=1
# Pin the demo date for a repeatable demo (D1 = DEMO_AS_OF - 1, D2 = DEMO_AS_OF). Blank = today.
DEMO_AS_OF=
# Optional: override generator path (defaults to ../gen_unrecon_day.py)
# GEN_PATH=c:\tasks\vss110\gen_unrecon_day.py
